"thesis": {
  "steps": ["Apply to the Board of Studies through your supervisor with title, registration number and publications.","Prepare a 30-minute pre-Ph.D. seminar; bring the report format and a list of examiners (three from West Bengal, three from outside).","Write the thesis and synopsis; the supervisor runs the plagiarism check (Drillbit).","Collect the No-Dues certificate signatures in sequence.","Print hard-bound copies (4, or 5 with a co-supervisor) and prepare CDs.","Fill the submission form with Annexures I and II and pay the fee through SBI Collect.","Submit with self-attested documents and take the submission certificate.","Viva-voce after the examiners' reports; then apply for the provisional certificate."],
  "links": [["Application format","https://drive.google.com/open?id=1wDWtXwjVSH2nr-tPmjH5tUYffjzvcV1zZWKtkf-MO0g"],["Sample pre-Ph.D. report","https://drive.google.com/open?id=1Ps1A7s_SCGuQ0hv3ixCL25K2osmZ19amLoIENjNMn3k"],["Beamer sample (Overleaf)","https://www.overleaf.com/read/frzphkqbjcrh"],["No-Dues form","https://drive.google.com/file/d/1P59zi88yl71dXDJKndTLg6hoazD_uma5/view"],["SBI Collect","https://www.onlinesbi.sbi/sbicollect/"],["VB result notices","https://www.visvabharati.ac.in/list_all_notice.html/type/result"],["VB forms","https://www.visvabharati.ac.in/DownloadForms.html"],["Shodhganga — VB Mathematics","https://shodhganga.inflibnet.ac.in/jspui/handle/10603/21702"]]
